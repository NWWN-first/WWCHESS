{
  "name": "wwchess-fantasy-autobattler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "simulate": "mkdir -p scripts/.cache && esbuild scripts/simulate1000.ts --bundle --platform=node --format=esm --packages=external --external:onnxruntime-node --outfile=scripts/.cache/sim1000.mjs --log-level=warning && node scripts/.cache/sim1000.mjs",
    "simulate:onnx": "USE_ONNX_SIM=1 npm run simulate",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "onnxruntime-web": "^1.31.1",
    "pixi.js": "^8.23.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.21.5",
    "gh-pages": "^6.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.21.0"
  }
}
